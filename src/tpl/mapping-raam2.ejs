<% if (message !== '') { %>
<p id="intro"><%- message %></p>
<% } %>
<div class="mappingSwitch">
    <label for="mappingRAWeb2-1-radio">RAAM 2 <> WCAG 2.2 <> EN 301 549 v4</label>
    <label for="mappingRAWeb2-2-radio">RAAM 1.1 <> RAWeb2</label>
</div>

<input type="radio" name="mappingRAWeb2" id="mappingRAWeb2-1-radio" checked class="sr-only">
<input type="radio" name="mappingRAWeb2" id="mappingRAWeb2-2-radio" class="sr-only">

<div id="mappingRAWeb2-1">
    <table class="diffTable">
        <tr><th scope="col">RAAM&nbsp;2</th><th scope="col">WCAG</th><th scope="col">EN 301 549 v4</th><th scope="col"><%= __('WCAG Techs') %></th></tr>
            <% topics.forEach(topic => {     
                topic.criteria.forEach(crit => { 
                    critId = `crit-${topic.number}-${crit.criterium.number}`
                    critName = `${topic.number}.${crit.criterium.number}`
            %>
        <tr>
            <td><a href="/<%= lang %>/raam2/criteres.html#<%= critId %>"><%= critName %></a></td>
            <td>
                <%
                if (crit.criterium.references.wcag !== undefined && crit.criterium.references.wcag.length !== 0 && !Array.isArray(crit.criterium.references.wcag)) { 
                    let SC = crit.criterium.references.wcag.trim() %>
                    <a href="<%= (lang==='fr')?'https://www.w3.org/Translations/WCAG22-fr/':'https://www.w3.org/TR/WCAG22/'%>#<%= slugify(SC) %>"><%- langOnWCAG(SC, lang) %></a>
                <% } %>
            </td>
            <td><%- langOnEUNorm(crit.criterium.references.norm, lang) %></td>
            <td><% if (crit.criterium.references.techniques !== undefined && crit.criterium.references.techniques.length !== 0) { %>
                        <% let techs = crit.criterium.references.techniques.map(e => { return e.trim() })
                            techs.forEach(e => { %><a href="<%= tech2URL(e) %>" hreflang="en"><%= e %></a><%= (techs.indexOf(e) != (techs.length-1))?', ': '.' %><% }) 
                        %>
                <% } %>
            </td>
        </tr>
        <% })
        }) %>
    </table>
</div>

